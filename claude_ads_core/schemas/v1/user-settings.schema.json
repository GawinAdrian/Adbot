{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:ai-marketing-hub:claude-ads:schema:core:v1:user-settings.schema.json", "title": "UserSettings v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "updated_at", "language", "country", "currency", "timezone", "active_account_ref", "cadence"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "artifact_type": {"const": "user-settings"},
    "updated_at": {"$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v1:workflow-common.schema.json#/$defs/datetime"},
    "language": {"enum": ["de", "pl"]},
    "country": {"enum": ["DE", "PL"]},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "timezone": {"type": "string", "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)+$"},
    "active_account_ref": {"anyOf": [{"type": "string", "pattern": "^[0-9]{10}$"}, {"type": "null"}]},
    "cadence": {
      "type": "object", "additionalProperties": false,
      "required": ["watch", "report", "report_weekday", "deep_review"],
      "properties": {
        "watch": {"enum": ["daily", "off"]},
        "report": {"enum": ["weekly", "biweekly", "monthly", "on-demand"]},
        "report_weekday": {"enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]},
        "deep_review": {"enum": ["monthly", "quarterly", "off"]}
      }
    }
  }
}
